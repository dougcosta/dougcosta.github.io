---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Layout from './Layout.astro';
import { formatDate } from '../utils/date';
import { tagSlug } from '../utils/posts';

type Props = CollectionEntry<'blog'>['data'];
const { title, description, pubDate, updatedDate, tags, heroImage, heroImageAlt } = Astro.props;
---

<Layout title={title} description={description}>
	<article class="post wrap">
		<header class="post__header">
			<p class="eyebrow"><time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>{updatedDate && <> · Atualizado em <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time></>}</p>
			<h1>{title}</h1>
			<p class="lede">{description}</p>
			{tags.length > 0 && <p class="tags label">{tags.map((tag) => <a href={`/tags/${tagSlug(tag)}/`}>#{tag}</a>)}</p>}
		</header>
		{heroImage && <figure class="hero-image"><Image widths={[640, 960, 1280]} sizes="(min-width: 60rem) 60rem, 100vw" src={heroImage} alt={heroImageAlt ?? ''} /></figure>}
		<div class="prose"><slot /></div>
	</article>
</Layout>

<script>
	import '../scripts/code-copy';
</script>

<style>
	.post { max-width: calc(var(--width-wide) + (var(--gutter) * 2)); }
	.post__header, .prose { max-width: var(--width-prose); }
	.post__header { padding-block: var(--space-12) var(--space-8); }
	h1 { margin-top: var(--space-4); font-size: var(--text-2xl); }
	.lede { margin-top: var(--space-6); }
	.tags { display: flex; flex-wrap: wrap; gap: var(--space-4); margin-top: var(--space-8); }
	.tags a { text-decoration: none; }
	.hero-image { margin-bottom: var(--space-12); }
	.hero-image img { width: 100%; }
	.prose { padding-top: var(--space-8); border-top: 1px solid var(--color-rule); font-size: var(--text-md); line-height: 1.8; }
	.prose :global(* + *):not(.code-copy) { margin-top: var(--space-6); }
	.prose :global(h2), .prose :global(h3) { margin-top: var(--space-16); }
	.prose :global(h2) { font-size: var(--text-xl); }
	.prose :global(h3) { font-size: var(--text-lg); }
	.prose :global(a) { color: var(--color-accent); }
	.prose :global(blockquote) { padding-left: var(--space-6); border-left: 2px solid var(--color-accent); color: var(--color-fg-muted); font-style: italic; }
	.prose :global(pre) { position: relative; padding: var(--space-6); overflow-x: auto; background: var(--color-bg-subtle); border: 1px solid var(--color-rule); }
	.prose :global(code) { font-family: var(--font-code); font-size: .85em; }
</style>
