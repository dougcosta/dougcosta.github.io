---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE } from '../consts';
import { getTranslations } from '../i18n';
import { getLocaleFromUrl } from '../i18n/utils';

interface Props {
	title?: string;
	description?: string;
	currentPost?: import('astro:content').CollectionEntry<'blog'>;
}

const { title, description = SITE.description, currentPost } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const t = getTranslations(locale);
const pageTitle = title ? `${title} — ${SITE.title}` : `${SITE.title} — ${SITE.tagline}`;
---

<html lang={locale}>
	<head>
		<!-- Google tag (gtag.js) -->
		{import.meta.env.PROD && (			
			<script async src="https://www.googletagmanager.com/gtag/js?id=G-FKJZHRENJ7"></script>
			<script>
				window.dataLayer = window.dataLayer || [];
				function gtag(){dataLayer.push(arguments);}
				gtag('js', new Date());

				gtag('config', 'G-FKJZHRENJ7');
			</script>
		)}
		<BaseHead title={pageTitle} description={description} />
	</head>

	<body>
		<Header currentPost={Astro.props.currentPost} />

		<a class="skip-link" href="#main">{t.common.skipToContent}</a>
		<main id="main">
			<slot />
		</main>

		<Footer />
	</body>
</html>
