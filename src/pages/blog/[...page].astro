---
import type { GetStaticPaths, Page } from 'astro';
import PageHeader from '../../components/PageHeader.astro';
import PostCard from '../../components/PostCard.astro';
import Layout from '../../layouts/Layout.astro';
import { BLOG } from '../../consts';
import { getPublishedPosts, type Post } from '../../utils/posts';

export const getStaticPaths = (async ({ paginate }) => paginate(await getPublishedPosts(), { pageSize: BLOG.postsPerPage })) satisfies GetStaticPaths;
const { page } = Astro.props as { page: Page<Post> };
const suffix = page.currentPage > 1 ? ` — página ${page.currentPage}` : '';
---

<Layout title={`Blog${suffix}`} description="Textos sobre liderança, engenharia de software, tecnologia e aprendizado contínuo.">
	<div class="wrap">
		<PageHeader eyebrow="Escritos" title="Blog" lede="Textos sobre liderança, engenharia de software, tecnologia e aprendizado contínuo." />
		<section class="post-list" aria-label="Posts do blog">
			{page.data.map((post) => <PostCard post={post} />)}
			{page.data.length === 0 && <p class="empty">Os primeiros textos estão a caminho.</p>}
		</section>
		{page.lastPage > 1 && <nav class="pagination" aria-label="Paginação do blog">{page.url.prev && <a href={page.url.prev}>← Mais recentes</a>}<span>Página {page.currentPage} de {page.lastPage}</span>{page.url.next && <a href={page.url.next}>Mais antigos →</a>}</nav>}
	</div>
</Layout>

<style>
	.post-list { margin-top: var(--space-4); }
	.empty { padding-block: var(--space-12); color: var(--color-fg-muted); }
	.pagination { display: flex; justify-content: space-between; margin-top: var(--space-12); font-family: var(--font-interface); font-size: var(--text-xs); font-weight: 500; letter-spacing: .08em; text-transform: uppercase; }
</style>
