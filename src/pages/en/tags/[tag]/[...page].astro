---
import type { GetStaticPaths, Page } from 'astro';
import PageHeader from '../../../../components/PageHeader.astro';
import PostCard from '../../../../components/PostCard.astro';
import Layout from '../../../../layouts/Layout.astro';
import { BLOG } from '../../../../consts';
import { getTranslations, type Locale } from '../../../../i18n';
import {
	collectTags,
	getPublishedPosts,
	postsByTag,
	type Post,
	tagSlug,
} from '../../../../utils/posts';

const locale: Locale = 'en';

export const getStaticPaths = (async ({ paginate }) => {
	const posts = await getPublishedPosts();
	const localizedPosts = posts.filter((post) => post.data.lang === 'en');
	const tags = collectTags(localizedPosts);

	return tags.flatMap((tag) =>
		paginate(postsByTag(localizedPosts, tag.slug), {
			params: { tag: tag.slug },
			pageSize: BLOG.postsPerPage,
			props: { tagName: tag.name },
		}),
	);
}) satisfies GetStaticPaths;

const t = getTranslations(locale);
const { page, tagName } = Astro.props as {
	page: Page<Post>;
	tagName: string;
};
---

<Layout title={`Topic: ${tagName}`} description={`Articles about ${tagName}.`}>
	<div class="wrap">
		<PageHeader
			eyebrow="Topic"
			title={tagName}
			lede={`${page.total} ${page.total === 1 ? 'article' : 'articles'} in this topic.`}
		>
			<p class="back">
				<a href="/en/tags/">← All topics</a>
			</p>
		</PageHeader>

		<section class="post-list">
			{page.data.map((post) => <PostCard post={post} />)}
		</section>
	</div>
</Layout>

<style>
	.back {
		margin-top: var(--space-6);
	}

	.post-list {
		margin-top: var(--space-4);
	}
</style>