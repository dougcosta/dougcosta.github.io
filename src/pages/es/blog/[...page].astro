---
import type { GetStaticPaths, Page } from 'astro';
import PageHeader from '../../../components/PageHeader.astro';
import PostCard from '../../../components/PostCard.astro';
import Layout from '../../../layouts/Layout.astro';
import { BLOG } from '../../../consts';
import { getTranslations, type Locale } from '../../../i18n';
import { getPublishedPosts, type Post } from '../../../utils/posts';

const locale: Locale = 'es';

export const getStaticPaths = (async ({ paginate }) => {
	const posts = await getPublishedPosts();
	const localizedPosts = posts.filter((post) => post.data.lang === 'es');

	return paginate(localizedPosts, {
		pageSize: BLOG.postsPerPage,
	});
}) satisfies GetStaticPaths;

const t = getTranslations(locale);
const { page } = Astro.props as { page: Page<Post> };
const suffix = page.currentPage > 1 ? ` — ${t.blog.page} ${page.currentPage}` : '';
---

<Layout title={`Blog${suffix}`} description={t.blog.lede}>
	<div class="wrap">
		<PageHeader
			eyebrow={t.blog.eyebrow}
			title={t.blog.title}
			lede={t.blog.lede}
		/>

		<section class="post-list" aria-label={t.blog.postsLabel}>
			{page.data.map((post) => <PostCard post={post} />)}
			{page.data.length === 0 && <p class="empty">{t.blog.empty}</p>}
		</section>

		{page.lastPage > 1 && (
			<nav class="pagination" aria-label={t.blog.pagination}>
				{page.url.prev && <a href={page.url.prev}>{t.blog.newer}</a>}
				<span>{t.blog.page} {page.currentPage} {t.blog.pageOf} {page.lastPage}</span>
				{page.url.next && <a href={page.url.next}>{t.blog.older}</a>}
			</nav>
		)}
	</div>
</Layout>

<style>
	.post-list { margin-top: var(--space-4); }
	.empty { padding-block: var(--space-12); color: var(--color-fg-muted); }
	.pagination { display: flex; justify-content: space-between; margin-top: var(--space-12); font-family: var(--font-interface); font-size: var(--text-xs); font-weight: 500; letter-spacing: .08em; text-transform: uppercase; }
</style>
