---
import PageHeader from '../../components/PageHeader.astro';
import Layout from '../../layouts/Layout.astro';
import { collectTags, getPublishedPosts } from '../../utils/posts';
const posts = await getPublishedPosts();
const tags = collectTags(posts.filter((post) => post.data.lang === 'pt-BR'));
---
<Layout title="Tópicos" description="Tópicos abordados no blog de Doug Costa.">
	<div class="wrap">
		<PageHeader eyebrow="Índice" title="Tópicos" lede="Assuntos explorados no blog." />
		{tags.length ? <ul class="topics">{tags.map((tag) => <li><a href={`/tags/${tag.slug}/`}><span>{tag.name}</span><small>{tag.count}</small></a></li>)}</ul> : <p class="empty">Os tópicos aparecerão à medida que os artigos forem publicados.</p>}
	</div>
</Layout>
<style>
	.topics { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 1px; margin-top: var(--space-12); padding: 1px; background: var(--color-rule); list-style: none; }
	.topics li { background: var(--color-bg); }
	.topics a { display: flex; justify-content: space-between; padding: var(--space-6); text-decoration: none; }
	small { color: var(--color-fg-faint); font-family: var(--font-interface); }
	.empty { margin-top: var(--space-12); color: var(--color-fg-muted); }
</style>
